# Copy to .env.local. For LOCAL Supabase, run `supabase start` and paste the
# printed values (or `supabase status`). NEVER commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Secret required in the x-cron-secret header for POST /api/resolve
CRON_SECRET=change-me-long-random

# Comma-separated auth user ids allowed to force resolution in production.
# (In development, any signed-in user can use the manual trigger.)
ADMIN_USER_IDS=

# Invite code required to register a new operative (server-validated)
ACCESS_CODE=BRAINDRAIN
